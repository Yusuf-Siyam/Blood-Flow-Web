# ----------------------------------------------------------------------
# Security & Performance Settings
# ----------------------------------------------------------------------

# Disable Directory Browsing
Options -Indexes

# Disable Server Signature
ServerSignature Off

# ----------------------------------------------------------------------
# Prevent Access to Sensitive Files
# ----------------------------------------------------------------------

# Block access to environment, Git, and htaccess files
<FilesMatch "^\.(env|git|htaccess)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to SQL dumps, logs, and sensitive config types
<FilesMatch "\.(sql|log|ini|sh|yml|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# HTTPS and URL Rewriting (Clean URLs)
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Enforce HTTPS (Handles standard SSL and Reverse Proxies like Cloudflare, Render, Railway)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Redirect direct *.php requests to clean URLs (e.g. login.php -> login)
    # Skip POST requests to avoid breaking forms
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.php[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 3. Internally rewrite clean URLs back to .php files
    # E.g. /login -> /login.php (if the file exists and is not a directory)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*?)/?$ $1.php [L]
</IfModule>

# ----------------------------------------------------------------------
# Security Headers
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
    # Prevent browsers from sniffing MIME types away from the declared Content-Type
    Header set X-Content-Type-Options "nosniff"

    # Avoid Clickjacking by restricting framing
    Header set X-Frame-Options "SAMEORIGIN"

    # Enable XSS protection filter in older browsers
    Header set X-XSS-Protection "1; mode=block"

    # Protect referrer information
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
